{
  "name": "ecjsonstorage",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "update": "ncu -u -x typescript && npm -i",
    "build": "npm run build:js && npm run build:dts",
    "build:js": "tsup src/*.ts --format esm,cjs --minify",
    "build:dts": "tsup src/index.ts --dts-only",
    "deleteAllBins": "node dist/deleteAllBins.cjs",
    "test": "vitest"
  },
  "keywords": [
    "ExtendsClass JSON-Storage API wrapper"
  ],
  "files": [
    "dist/index.*",
    "src/index.ts",
    "test/*",
    ".env.example",
    "CHANGELOG.md",
    "LICENSE",
    "pack*.json",
    "README.md"
  ],
  "type": "module",
  "devDependencies": {
    "@types/dotenv-safe": "^9.1.0",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.4",
    "dotenv-safe": "^9.1.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
