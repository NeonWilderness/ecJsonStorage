{
  "name": "@neonwilderness/ecjsonstorage",
  "version": "1.0.4",
  "description": "",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "update": "ncu -u -x typescript && npm i",
    "build": "npm run build:js && npm run build:dts",
    "build:js": "tsup src/*.ts --format esm,cjs --minify",
    "build:dts": "tsup src/index.ts --format esm,cjs --dts-only",
    "deleteAllBins": "node dist/deleteAllBins.cjs",
    "test": "vitest"
  },
  "keywords": [
    "ExtendsClass JSON-Storage API wrapper"
  ],
  "files": [
    "dist/index.*",
    "src/index.ts",
    "test/*",
    ".env.example",
    "CHANGELOG.md",
    "LICENSE",
    "pack*.json",
    "README.md"
  ],
  "type": "module",
  "devDependencies": {
    "@types/dotenv-safe": "^9.1.0",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.5",
    "dotenv-safe": "^9.1.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.27.2": true
  }
}
